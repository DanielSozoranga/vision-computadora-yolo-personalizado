# Copia este archivo como .env y completa tus datos de Roboflow.
# El archivo .env esta en el .gitignore y nunca se sube a GitHub.

# Clave API privada: Roboflow > Settings > API Keys
ROBOFLOW_API_KEY=pon_aqui_tu_clave

# Estos tres datos aparecen en la direccion de tu proyecto en Roboflow:
# https://app.roboflow.com/<WORKSPACE>/<PROYECTO>/<VERSION>
ROBOFLOW_WORKSPACE=daniels-workspace
ROBOFLOW_PROJECT=objetos-personales
ROBOFLOW_VERSION=1
